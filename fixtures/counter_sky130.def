VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN counter ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 21255 21255 ) ;
ROW ROW_0 unithd 2300 2720 N DO 36 BY 1 STEP 460 0 ;
ROW ROW_1 unithd 2300 5440 FS DO 36 BY 1 STEP 460 0 ;
ROW ROW_2 unithd 2300 8160 N DO 36 BY 1 STEP 460 0 ;
ROW ROW_3 unithd 2300 10880 FS DO 36 BY 1 STEP 460 0 ;
ROW ROW_4 unithd 2300 13600 N DO 36 BY 1 STEP 460 0 ;
ROW ROW_5 unithd 2300 16320 FS DO 36 BY 1 STEP 460 0 ;
TRACKS X 230 DO 46 STEP 460 LAYER li1 ;
TRACKS Y 170 DO 62 STEP 340 LAYER li1 ;
TRACKS X 170 DO 62 STEP 340 LAYER met1 ;
TRACKS Y 170 DO 62 STEP 340 LAYER met1 ;
TRACKS X 230 DO 46 STEP 460 LAYER met2 ;
TRACKS Y 230 DO 46 STEP 460 LAYER met2 ;
TRACKS X 340 DO 31 STEP 680 LAYER met3 ;
TRACKS Y 340 DO 31 STEP 680 LAYER met3 ;
TRACKS X 460 DO 23 STEP 920 LAYER met4 ;
TRACKS Y 460 DO 23 STEP 920 LAYER met4 ;
TRACKS X 1700 DO 6 STEP 3400 LAYER met5 ;
TRACKS Y 1700 DO 6 STEP 3400 LAYER met5 ;
GCELLGRID X 0 DO 3 STEP 6900 ;
GCELLGRID Y 0 DO 3 STEP 6900 ;
COMPONENTS 11 ;
    - _07_ sky130_fd_sc_hd__nand2_1 + PLACED ( 4600 5440 ) FS ;
    - _08_ sky130_fd_sc_hd__xor2_1 + PLACED ( 7820 13600 ) N ;
    - _09_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 2760 8160 ) N ;
    - _10_ sky130_fd_sc_hd__nand4_1 + PLACED ( 11040 13600 ) N ;
    - _11_ sky130_fd_sc_hd__a31oi_1 + PLACED ( 15180 5440 ) FS ;
    - _12_ sky130_fd_sc_hd__lpflow_isobufsrc_1 + PLACED ( 15180 10880 ) FS ;
    - _13_ sky130_fd_sc_hd__xnor2_1 + PLACED ( 15180 8160 ) N ;
    - _14_ sky130_fd_sc_hd__dfrtp_1 + PLACED ( 5980 8160 ) N ;
    - _15_ sky130_fd_sc_hd__dfrtp_1 + PLACED ( 5520 2720 ) N ;
    - _16_ sky130_fd_sc_hd__dfrtp_1 + PLACED ( 5980 5440 ) FS ;
    - _17_ sky130_fd_sc_hd__dfrtp_1 + PLACED ( 5980 10880 ) FS ;
END COMPONENTS
PINS 7 ;
    - clk + NET clk + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 7590 242 ) N ;
    - count[0] + NET count[0] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 12190 242 ) N ;
    - count[1] + NET count[1] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 9430 242 ) N ;
    - count[2] + NET count[2] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 11270 242 ) N ;
    - count[3] + NET count[3] + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 13110 242 ) N ;
    - en + NET en + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 10350 242 ) N ;
    - rst_n + NET rst_n + DIRECTION INPUT + USE SIGNAL
      + PORT
        + LAYER met2 ( -70 -242 ) ( 70 243 )
        + PLACED ( 8510 242 ) N ;
END PINS
NETS 14 ;
    - _00_ ( _14_ D ) ( _08_ X ) + USE SIGNAL ;
    - _01_ ( _15_ D ) ( _09_ Y ) + USE SIGNAL ;
    - _02_ ( _16_ D ) ( _12_ X ) + USE SIGNAL ;
    - _03_ ( _17_ D ) ( _13_ Y ) + USE SIGNAL ;
    - _04_ ( _09_ B ) ( _07_ Y ) + USE SIGNAL ;
    - _05_ ( _13_ B ) ( _12_ A ) ( _10_ Y ) + USE SIGNAL ;
    - _06_ ( _12_ SLEEP ) ( _11_ Y ) + USE SIGNAL ;
    - clk ( PIN clk ) ( _17_ CLK ) ( _16_ CLK ) ( _15_ CLK ) ( _14_ CLK ) + USE CLOCK ;
    - count[0] ( PIN count[0] ) ( _14_ Q ) ( _11_ A1 ) ( _10_ A ) ( _08_ A ) ( _07_ A ) + USE SIGNAL ;
    - count[1] ( PIN count[1] ) ( _15_ Q ) ( _11_ A2 ) ( _10_ B ) ( _09_ A ) + USE SIGNAL ;
    - count[2] ( PIN count[2] ) ( _16_ Q ) ( _11_ B1 ) ( _10_ C ) + USE SIGNAL ;
    - count[3] ( PIN count[3] ) ( _17_ Q ) ( _13_ A ) + USE SIGNAL ;
    - en ( PIN en ) ( _11_ A3 ) ( _10_ D ) ( _08_ B ) ( _07_ B ) + USE SIGNAL ;
    - rst_n ( PIN rst_n ) ( _17_ RESET_B ) ( _16_ RESET_B ) ( _15_ RESET_B ) ( _14_ RESET_B ) + USE SIGNAL ;
END NETS
END DESIGN
