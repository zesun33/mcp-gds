VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN mini ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 10000 10000 ) ;
COMPONENTS 1 ;
- u1 INV_X1 + PLACED ( 1000 1000 ) N ;
END COMPONENTS
PINS 2 ;
- clk + NET clk ;
- y + NET y ;
END PINS
NETS 1 ;
- clk ( u1 A ) ( PIN clk ) ;
END NETS
END DESIGN
